generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  RENTER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  FLAGGED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         UserRole  @default(RENTER)
  avatarUrl    String?   @map("avatar_url")
  bio          String?
  phone        String?
  isVerified   Boolean   @default(false) @map("is_verified")
  isBanned     Boolean   @default(false) @map("is_banned")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  listings         Listing[]
  bookingsAsRenter Booking[] @relation("RenterBookings")
  reviewsGiven     Review[]  @relation("ReviewerReviews")
  reviewsReceived  Review[]  @relation("RevieweeReviews")
  flags            Flag[]

  @@map("users")
}

model Listing {
  id              String        @id @default(cuid())
  ownerId         String        @map("owner_id")
  title           String
  description     String?
  resortName      String        @map("resort_name")
  location        String
  state           String?
  country         String        @default("US")
  membershipTier  String        @map("membership_tier")
  unitSize        String        @map("unit_size")
  maxGuests       Int           @map("max_guests")
  pricePerWeek    Decimal       @map("price_per_week") @db.Decimal(10, 2)
  amenities       Json          @default("[]")
  photos          Json          @default("[]")
  status          ListingStatus @default(ACTIVE)
  isVerified      Boolean       @default(false) @map("is_verified")
  avgRating       Float?        @map("avg_rating")
  totalReviews    Int           @default(0) @map("total_reviews")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  availableWeeks AvailableWeek[]
  bookings       Booking[]
  flags          Flag[]

  @@index([ownerId])
  @@index([location])
  @@index([status])
  @@map("listings")
}

model AvailableWeek {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isBooked  Boolean  @default(false) @map("is_booked")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking Booking?

  @@index([listingId])
  @@index([startDate, endDate])
  @@map("available_weeks")
}

model Booking {
  id                   String        @id @default(cuid())
  listingId            String        @map("listing_id")
  renterId             String        @map("renter_id")
  weekId               String        @unique @map("week_id")
  status               BookingStatus @default(PENDING)
  stripePaymentIntentId String?      @map("stripe_payment_intent_id")
  stripeTransferId     String?       @map("stripe_transfer_id")
  totalAmount          Decimal       @map("total_amount") @db.Decimal(10, 2)
  platformFee          Decimal       @map("platform_fee") @db.Decimal(10, 2)
  ownerPayout          Decimal       @map("owner_payout") @db.Decimal(10, 2)
  guestCount           Int           @default(1) @map("guest_count")
  specialRequests      String?       @map("special_requests")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  listing Listing       @relation(fields: [listingId], references: [id])
  renter  User          @relation("RenterBookings", fields: [renterId], references: [id])
  week    AvailableWeek @relation(fields: [weekId], references: [id])
  review  Review?

  @@index([listingId])
  @@index([renterId])
  @@index([status])
  @@map("bookings")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique @map("booking_id")
  reviewerId String   @map("reviewer_id")
  revieweeId String   @map("reviewee_id")
  listingId  String   @map("listing_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewee User    @relation("RevieweeReviews", fields: [revieweeId], references: [id])

  @@index([revieweeId])
  @@index([listingId])
  @@map("reviews")
}

model Flag {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  userId    String   @map("user_id")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@map("flags")
}
